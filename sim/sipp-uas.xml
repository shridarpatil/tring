<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  SIPp UAS scenario — answers every inbound INVITE with 200 OK, accepts
  ACK, waits for BYE, replies 200 OK. Acts as the "far end" of a SIP
  trunk for local integration testing.

  Run via docker-compose (service `sip-sim` in docker-compose.yml). The
  SDP advertises an RTP port but no media is actually generated — useful
  for signaling-path verification (INVITE → 200 OK → BYE round-trip).
  Tring's FS will see "media timeout" on real call attempts unless
  rtp-timeout is relaxed on the test trunk gateway (recommended:
  rtp-timeout-sec=0 on the trunk via the extra_params field).

  Usage:
    docker compose up -d sip-sim
    # Create a trunk in the UI: register=false, proxy_ip=127.0.0.1:5070
    # Originate via API → SIPp answers, logs the call

  See docs/TRUNK_SIM.md for the full integration test recipe.
-->
<scenario name="UAS — Tata trunk simulator">

  <recv request="INVITE" crlf="true"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sim@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="500"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sim@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=tata-sim 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 8 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
    ]]>
  </send>

  <recv request="ACK" optional="true" rtd="true" crlf="true"/>

  <!-- Hold the call open. Real BYE arrives whenever Tring/FS hangs up. -->
  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <!-- Per-scenario stats partitions (kept simple — UAS just loops). -->
  <ResponseTimeRepartition value="10, 20, 30, 50, 100"/>
  <CallLengthRepartition value="500, 1000, 5000, 10000"/>

</scenario>
