# Tring deployment environment.
#
# Copy this file to .env (which is gitignored) and fill in real values.
# Read by docker-compose; propagated into the FreeSWITCH container's env
# where vars.xml's `X-PRE-PROCESS env-set` lines pick them up.

# ---- Trunk providers (pre-baked) -------------------------------------
# Tring ships gateway stubs for four Indian trunks: Exotel, Airtel,
# Jio, and Tata. To activate any of them:
#   1. Fill in the three credential vars below for that provider.
#   2. Set <PROV>_REGISTER=true.
#   3. docker compose up -d --force-recreate freeswitch.
#   4. Sofia should report the gateway as REGED in ~30s:
#        docker exec tring-fs fs_cli -x "sofia status profile external"
#   5. Register an outbound number with Tring:
#        POST /v1/numbers {"e164":"+91...", "type":"outbound", "provider":"<name>"}
#
# Switching providers is config-only — no code or schema changes.

# Exotel (CPaaS; supports 1600 series). Realm is usually
# `<account>.pstn.exotel.com` or `<account>.in.exotel.com`.
EXOTEL_SIP_USERNAME=
EXOTEL_SIP_PASSWORD=
EXOTEL_SIP_REALM=
EXOTEL_REGISTER=false

# Airtel enterprise SIP trunk. Realm from your Airtel account manager.
AIRTEL_SIP_USERNAME=
AIRTEL_SIP_PASSWORD=
AIRTEL_SIP_REALM=
AIRTEL_REGISTER=false

# Reliance Jio enterprise SIP trunk.
JIO_SIP_USERNAME=
JIO_SIP_PASSWORD=
JIO_SIP_REALM=
JIO_REGISTER=false

# Tata Tele Business Services SIP trunk.
TATA_SIP_USERNAME=
TATA_SIP_PASSWORD=
TATA_SIP_REALM=
TATA_REGISTER=false

# ---- Network / NAT ---------------------------------------------------
# Public address FreeSWITCH advertises in SDP and uses for external
# RTP. Critical on any VPS: if this doesn't match the real public IP,
# SIP signaling works but media is one-way (callers can't hear you, or
# vice versa).
#
# Accepted forms:
#   TRING_PUBLIC_IP=203.0.113.42                # bare public IP
#   TRING_PUBLIC_IP=host:voice.example.com      # DNS A record
#   TRING_PUBLIC_IP=stun:stun.freeswitch.org    # STUN auto-detect (dev default)
#
# Leave commented for dev (STUN default applies). On AWS/GCP/DO/Hetzner,
# uncomment with your VPS public IP.
# TRING_PUBLIC_IP=

# ---- Tring API (rarely overridden in dev) ----------------------------
# TRING_JWT_SECRET=
# TRING_FS_BASIC_AUTH=fs:fs_dev_secret_change_me_in_prod
# TRING_WS_URL=ws://127.0.0.1:7443
