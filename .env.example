# Tring deployment environment.
#
# Copy this file to .env (which is gitignored) and fill in real values.
# Read by docker-compose; propagated into the FreeSWITCH container's env
# where vars.xml's `X-PRE-PROCESS env-set` lines pick them up.

# ---- SIP trunks ------------------------------------------------------
# Trunks are managed via the admin console at /trunks, NOT env vars.
# Each trunk row renders to freeswitch/conf/sip_profiles/external/
# dynamic/t_<uuid>.xml on save; sofia profile external is rescanned
# live (zero-downtime). Both REGISTER-auth (Exotel/Plivo aggregator-
# style) and IP-auth (Tata private-circuit style) are supported in the
# UI form. No EXOTEL_/AIRTEL_/JIO_/TATA_* env vars are needed anymore.

# ---- Network / NAT ---------------------------------------------------
# Public address FreeSWITCH advertises in SDP and uses for external
# RTP. Critical on any VPS: if this doesn't match the real public IP,
# SIP signaling works but media is one-way (callers can't hear you, or
# vice versa).
#
# Accepted forms:
#   TRING_PUBLIC_IP=203.0.113.42                # bare public IP
#   TRING_PUBLIC_IP=host:voice.example.com      # DNS A record
#
# Leave commented for dev — FreeSWITCH advertises its LAN IP, which is
# correct on a local network and always binds. On AWS/GCP/DO/Hetzner,
# uncomment with your VPS public IP (mismatch = one-way audio).
# TRING_PUBLIC_IP=

# RTP UDP port range. FreeSWITCH allocates RTP ports for media within
# this range and uses NO ports outside it. Each concurrent call consumes
# 2 ports (RTP + RTCP), so 100 ports = ~50 simultaneous calls.
#
# Narrow this on a VPS to match your firewall rules — e.g. open only
# UDP/16384-16483 (100 ports) and set the same below. Smaller range =
# smaller attack surface, easier to reason about.
# TRING_RTP_START_PORT=16384
# TRING_RTP_END_PORT=32768

# ---- WebRTC ICE servers (STUN + TURN) --------------------------------
# Browsers behind NAT need help discovering their public IP candidates.
# STUN handles the easy case (asymmetric/cone NAT — most home networks).
# TURN is the fallback for symmetric NAT and CGNAT — it relays media
# through a public-IP server. Without TURN, agents on those networks
# will see calls connect at the SIP level but get no audio.
#
# STUN: defaults to Google's public server. Override with your own if
# you don't want browsers reaching out to Google.
# TRING_STUN_URL=stun:stun.l.google.com:19302
#
# TURN: bring-your-own. Run coturn yourself, or use a cloud TURN
# service (Twilio, Cloudflare, Xirsys). All three TURN vars are needed
# together — leaving them blank disables TURN (STUN-only mode).
# TRING_TURN_URL=turn:turn.example.com:3478
# TRING_TURN_USERNAME=
# TRING_TURN_PASSWORD=

# ---- Image tag for prebuilt containers -------------------------------
# Default `develop` tracks the latest main push (CI rebuilds on every
# commit). For a stable deploy, pin to a release tag:
#   TRING_TAG=v0.1.0
# Docker Hub mirror: shridh0r/tring-api:${TRING_TAG}
# TRING_TAG=develop

# ---- Tring API (rarely overridden in dev) ----------------------------
# TRING_JWT_SECRET=
# TRING_FS_BASIC_AUTH=fs:fs_dev_secret_change_me_in_prod
# TRING_WS_URL=ws://127.0.0.1:7443
