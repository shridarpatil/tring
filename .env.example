#######################################################################
#  Tring configuration
#
#  cp .env.example .env   (or just `make up` — it seeds .env for you)
#
#  docker-compose loads this into every service; the Go binaries read
#  TRING_* via koanf. Delete any line to fall back to its built-in
#  default. Values below are tuned for LOCAL DEV on one machine.
#######################################################################


#======================================================================
# 0. TIMEZONE  (applies to EVERY container)
#
#   One value drives all services: the Go binaries (api/orchestrator/
#   gateway), FreeSWITCH, Postgres and Redis. The Go binaries embed the
#   IANA tz database, so this resolves even on the distroless image. It
#   governs server-local time — notably the IVR Timing node's business
#   hours. Use an IANA name (e.g. Asia/Kolkata, UTC, America/New_York).
#======================================================================

TZ=Asia/Kolkata


#======================================================================
# 1. SECRETS  —  CHANGE THESE IN PRODUCTION
#======================================================================

TRING_JWT_SECRET=tring_dev_jwt_secret_change_me_in_prod
TRING_FS_BASIC_AUTH=fs:fs_dev_secret_change_me_in_prod


#======================================================================
# 2. DATABASE & CACHE
#======================================================================

# [api + orchestrator -> Postgres] DB connection (dev port 5434, not 5432).
TRING_DSN=postgres://tring:tring_dev@127.0.0.1:5434/tring

# [api + orchestrator + gateway -> Redis] shared flow cache + agent presence +
# queue depth. All three MUST point at the SAME Redis. Empty = all disabled.
TRING_REDIS_ADDR=127.0.0.1:6379

# Structured logging. format: text (logfmt, readable locally) | json (for log
# shippers — logchef/Loki). level: debug|info|warn|error.
TRING_LOG_FORMAT=text
TRING_LOG_LEVEL=info


#======================================================================
# 3. FIRST-BOOT BOOTSTRAP  (seeds a tenant + admin on an empty DB)
#   No-op on later boots; changing these does NOT rotate credentials.
#======================================================================

TRING_BOOTSTRAP_TENANT=Default
TRING_ADMIN_EMAIL=admin@tring.local
TRING_ADMIN_PASSWORD=tring_dev_change_me


#======================================================================
# 4. NETWORK MODE   ★ the setting people get wrong ★
#
#   Tring = 3 Go services around a PRIVATE FreeSWITCH. Each address below
#   is ONE hop between two of them (or to an outsider). In local dev every
#   hop is 127.0.0.1 so they look redundant — but they split apart on LAN/
#   prod, which is why each is its own knob. The components:
#
#     api           cmd/api          — REST + admin console
#     orchestrator  cmd/orchestrator — FreeSWITCH ESL + IVR executor (queues)
#     gateway       cmd/gateway      — browser WebRTC <-> FreeSWITCH (SIP B2BUA)
#     FreeSWITCH    private media core — NEVER internet-exposed
#     outsiders     the visitor's browser, and (later) the telco trunk
#
#   Each var below is tagged [FROM -> TO] so you know which hop it is.
#   Pick a mode:
#   • LOCAL DEV (default) — everything + browser on ONE machine. Loopback
#       127.0.0.1, immune to Wi-Fi/IP changes. Browser opens :8087.
#   • LAN / staging — browser on another device: set every 127.0.0.1 below
#       to the host's LAN IP; leave TRING_INTERNAL_IP empty (FS binds LAN).
#   • PRODUCTION — leave TRING_INTERNAL_IP empty; set TRING_PUBLIC_IP to the
#       public IP and TRING_GATEWAY_PUBLIC_URL to the public gateway URL.
#   Full guide: docs/ARCHITECTURE.md (§12 Deployment topology)
#======================================================================

# [FreeSWITCH] THE ANCHOR — the IP FreeSWITCH binds its internal SIP profile
# to, and its SIP auth realm/domain. Every other address here must agree with it.
#   empty     = host LAN IP   (LAN / prod)
#   127.0.0.1 = loopback dev  (Wi-Fi-immune; browser must be on the same host)
TRING_INTERNAL_IP=127.0.0.1

# [gateway -> FreeSWITCH] where the gateway dials FS's SIP. Point at INTERNAL_IP:5060.
TRING_FS_SIP_ADDR=127.0.0.1:5060

# [FreeSWITCH -> orchestrator] where the FS dialplan hands an inbound call to the
# orchestrator's IVR executor (the queue/teams/IVR entry point). Loopback because
# the orchestrator runs beside FS; change only if it runs on another host/port.
TRING_IVR_SOCKET=127.0.0.1:8086

# [FreeSWITCH -> gateway] the IP the gateway advertises to FS so FS sends SIP/RTP
# media BACK to it (also the gateway's auth From-domain). Must be reachable by
# FS — match TRING_INTERNAL_IP.
TRING_GATEWAY_ADVERT_IP=127.0.0.1

# [browser -> gateway] the gateway URL the api hands a visitor's browser to start
# a WebRTC call.   dev http://localhost:8087  ·  prod https://gw.example.com
TRING_GATEWAY_PUBLIC_URL=http://127.0.0.1:8087

# [FreeSWITCH -> telco] public IP FS stamps into SDP so a TRUNK sends RTP back.
# Browsers never use this; only matters once a real trunk is wired. empty = LAN IP.
TRING_PUBLIC_IP=


#======================================================================
# 5. MEDIA GATEWAY  (cmd/gateway — browser WebRTC ⇄ private FreeSWITCH)
#======================================================================

# [browser + agents -> gateway] the gateway's own HTTP/WebRTC listen addr
# (visitor /webrtc/offer + the agent WebSocket). ':8087' = all interfaces.
TRING_GATEWAY_ADDR=:8087
# [FreeSWITCH -> gateway] SIP-UAS port FS dials to deliver an agent's call leg.
TRING_GATEWAY_SIP_PORT=5090

# Phase 4 PSTN plug: route inbound DIDs through the media plane (pion) instead
# of the orchestrator's FS-side IVR. FS becomes just the carrier edge (SIP +
# G.711<->Opus); the call runs the SAME IVR as web and transfers ring web agents.
# TRING_PSTN_VIA_GATEWAY=true

# WebRTC media UDP range (browser ⇄ gateway), ~1 port/call.
# Default caps you at ~100 concurrent calls — widen for real load.
TRING_GATEWAY_UDP_MIN=10000
TRING_GATEWAY_UDP_MAX=10100

# Require a backend-minted gateway call token on /webrtc/offer (default true =
# safe). Visitor tokens come from /v1/guest-credentials (your backend, API key);
# guests get one with no client_ref. Set false to allow the raw anonymous path
# (browser posts token-less with a flow id) — still flow-pinned/can't reach a
# trunk, but then the offer endpoint is unauthenticated.
TRING_GATEWAY_REQUIRE_AUTH=true

# Seconds an inbound agent leg rings before the gateway times out.
TRING_GATEWAY_AGENT_RING_TIMEOUT=45

# FreeSWITCH directory user the gateway digest-auths as (dev defaults).
TRING_FS_AUTH_USER=1000
TRING_FS_AUTH_PASS=1234


#======================================================================
# 6. FREESWITCH ↔ TELCO TRUNKS
#   Trunks themselves are managed in the console (/trunks), not here.
#======================================================================

# [orchestrator + api -> FreeSWITCH] ESL event socket / control channel —
# how Tring commands FreeSWITCH (originate, bridge, playback, etc.).
TRING_ESL_ADDR=127.0.0.1:8021
TRING_ESL_PASSWORD=ClueCon

# RTP port range for trunk (telco) media — 2 ports per call.
TRING_RTP_START_PORT=16384
TRING_RTP_END_PORT=32768


#======================================================================
# 7. CALL RECORDING STORAGE  (optional S3 / S3-compatible)
#
#   Recording itself is a per-tenant toggle in the console (Settings →
#   Record calls). Recordings are always stereo (agent left / customer
#   right). Format + sample rate are configurable (applied to both api
#   and orchestrator):
#     TRING_RECORD_FORMAT      ogg = Ogg Vorbis (default, ~25x smaller
#                              than WAV, no extra module); mp3 = mod_shout
#                              (similar size, plays in Safari/iOS unlike
#                              Ogg); wav = uncompressed.
#     TRING_RECORD_SAMPLE_RATE Hz; 8000 (default) is telephony narrowband,
#                              16000 = wideband, 0 = session-native (48k).
#
#   By default recordings stay on a local Docker volume.
#   Set S3 details below and finished recordings upload to S3 (date-wise
#   key recordings/<tenant>/YYYY/MM/DD/<id>.ogg) and the local copy is
#   deleted; the console streams them back from S3. Empty bucket = local.
#   Works with AWS S3, MinIO, Cloudflare R2, etc. (leave endpoint empty
#   for AWS; set it to your host for MinIO/R2).
#
#   Auth: set ACCESS_KEY + SECRET_KEY for static credentials. Leave BOTH
#   empty on AWS to use the instance's IAM role (EC2 instance profile /
#   ECS task role / EKS IRSA) — no secrets in config.
#======================================================================

# Recording format/quality (see section header). Stereo is always on.
TRING_RECORD_FORMAT=ogg
TRING_RECORD_SAMPLE_RATE=8000

TRING_S3_BUCKET=
TRING_S3_REGION=
TRING_S3_ENDPOINT=
# Leave ACCESS_KEY/SECRET_KEY empty on AWS to use the attached IAM role.
TRING_S3_ACCESS_KEY=
TRING_S3_SECRET_KEY=
TRING_S3_PREFIX=recordings
TRING_S3_USE_SSL=true


#======================================================================
# 8. WebRTC ICE  (STUN / TURN)
#
#   STUN is intentionally OFF — the gateway is the public endpoint, so
#   it learns the browser's address itself (works through symmetric NAT).
#   TURN is only the fallback for UDP-blocking networks (corporate /
#   guest Wi-Fi); prefer TURNS on 443. Set all three together, or none.
#======================================================================

TRING_STUN_URL=
TRING_TURN_URL=
# Static TURN creds — handed verbatim to clients. Fine for a closed dev setup,
# but DON'T ship these inside mobile app binaries (extractable, shared, no expiry).
TRING_TURN_USERNAME=
TRING_TURN_PASSWORD=
# Preferred for production / mobile: EPHEMERAL coturn REST-API credentials. Set a
# shared secret here (and `use-auth-secret` + `static-auth-secret=<this>` in
# coturn) and the API mints short-lived per-call creds — the secret never reaches
# clients. When set, TURN_USERNAME/TURN_PASSWORD are ignored. The credential
# lifetime is the TENANT's max call duration (Settings → Max call duration), so
# it always covers a full-length call — there's no global TTL knob here.
TRING_TURN_SECRET=


#======================================================================
# 9. IMAGE TAG
#   `develop` tracks latest main; pin a release (e.g. v0.1.0) for prod.
#======================================================================

TRING_TAG=develop
