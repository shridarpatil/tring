# Tring deployment environment — copy to .env and adjust.
#
#   cp .env.example .env
#
# `make up` copies this automatically if .env is missing. docker-compose loads
# .env into every service; the Go binaries read TRING_* via koanf (env > built-in
# default). Anything you delete here falls back to the binary's built-in default.
#
# The defaults below are for LOCAL DEV on one machine (loopback — survives Wi-Fi
# / IP changes). See "NETWORK MODE" below to switch to LAN or production.

# ── Image tag ─────────────────────────────────────────────────────────
# `develop` tracks the latest main build; pin a release for stable deploys.
TRING_TAG=develop

# ── Database / cache / secrets ────────────────────────────────────────
TRING_DSN=postgres://tring:tring_dev@127.0.0.1:5434/tring
# Redis backs the IVR flow cache AND agent presence. api + orchestrator +
# gateway MUST share the same Redis. Empty disables both (presence badge +
# ring-only-online-agents stop working).
TRING_REDIS_ADDR=127.0.0.1:6379
# CHANGE THESE IN PRODUCTION.
TRING_JWT_SECRET=tring_dev_jwt_secret_change_me_in_prod
TRING_FS_BASIC_AUTH=fs:fs_dev_secret_change_me_in_prod

# ── First-boot bootstrap (seeds a tenant + admin on an empty DB) ──────
# No-op on every later boot; changing these does NOT rotate credentials.
TRING_BOOTSTRAP_TENANT=Default
TRING_ADMIN_EMAIL=admin@tring.local
TRING_ADMIN_PASSWORD=tring_dev_change_me

# ── FreeSWITCH ESL (control channel) ──────────────────────────────────
TRING_ESL_ADDR=127.0.0.1:8021
TRING_ESL_PASSWORD=ClueCon

# ════════════════════════════════════════════════════════════════════
# NETWORK MODE — the IPs below must all agree with where FreeSWITCH binds.
#
#  • LOCAL DEV (default here): everything + the browser on ONE machine.
#    Loopback (127.0.0.1) — immune to Wi-Fi/IP changes. Browser uses
#    http://localhost:8087.
#  • LAN / staging (browser on another device): set the four IPs to the
#    host's LAN IP and leave TRING_INTERNAL_IP empty (FS binds its LAN IP).
#  • PRODUCTION (static IP / DNS): leave TRING_INTERNAL_IP empty, set
#    TRING_PUBLIC_IP to the public IP and TRING_GATEWAY_PUBLIC_URL to the
#    public gateway URL. See docs/EDGE_DEPLOYMENT.md.
# ════════════════════════════════════════════════════════════════════

# FreeSWITCH internal-profile bind IP + auth-realm domain. Empty = the host's
# LAN IP. 127.0.0.1 = loopback dev (Wi-Fi-immune; browser must be same-host).
TRING_INTERNAL_IP=127.0.0.1
# Public IP FreeSWITCH advertises to TELCO trunks (SDP/RTP). Empty = LAN IP.
# Set to the real public IP on a VPS, or one-way audio. (Browsers don't use this.)
TRING_PUBLIC_IP=
# FS RTP range for TRUNK media (telco). 2 ports/call.
TRING_RTP_START_PORT=16384
TRING_RTP_END_PORT=32768

# ── Agent transport ───────────────────────────────────────────────────
# "gateway" (default): agents speak raw WebRTC via the media gateway.
# "sip" is the legacy mode (no longer supported by the SDK).
TRING_AGENT_TRANSPORT=gateway
TRING_AGENT_GATEWAY=tring-gw

# ── Media gateway (cmd/gateway) ───────────────────────────────────────
TRING_GATEWAY_ADDR=:8087
# IP the gateway advertises to FreeSWITCH for the SIP/RTP leg + uses as its
# auth From-domain. Must match TRING_INTERNAL_IP (loopback dev → 127.0.0.1).
TRING_GATEWAY_ADVERT_IP=127.0.0.1
# Browser-reachable gateway URL the API returns to visitors. Loopback dev →
# localhost; LAN → http://<lan-ip>:8087; prod → https://gw.example.com.
TRING_GATEWAY_PUBLIC_URL=http://127.0.0.1:8087
TRING_GATEWAY_SIP_PORT=5090
# WebRTC media UDP range (browser ⇄ gateway). ~1 port/call — widen well past
# 100 for any real load (default caps you at ~100 concurrent calls).
TRING_GATEWAY_UDP_MIN=10000
TRING_GATEWAY_UDP_MAX=10100
# Where the gateway dials the PRIVATE FreeSWITCH. Must match TRING_INTERNAL_IP.
TRING_FS_SIP_ADDR=127.0.0.1:5060
# FreeSWITCH directory user the gateway digest-auths as (dev defaults).
TRING_FS_AUTH_USER=1000
TRING_FS_AUTH_PASS=1234
# Optional default IVR flow for token-less visitor calls. Empty = none.
TRING_FS_FLOW_ID=
# Require a gateway call token on /webrtc/offer. Off = anonymous visitor calls
# allowed (flow-pinned, can't reach a trunk). On = forbid anonymous visitors.
TRING_GATEWAY_REQUIRE_AUTH=false
# Seconds an inbound agent leg rings before the gateway gives FS a timeout.
TRING_GATEWAY_AGENT_RING_TIMEOUT=45

# ── WebRTC ICE (STUN / TURN) ──────────────────────────────────────────
# STUN is intentionally OFF: the gateway is the public endpoint, so it
# discovers the browser's reflexive address itself (works through symmetric
# NAT too). Leave empty. See docs/EDGE_DEPLOYMENT.md.
TRING_STUN_URL=
# TURN: the fallback for clients on UDP-blocking networks (corporate/guest
# Wi-Fi). Prefer TURNS on 443. All three together, or leave blank to disable.
TRING_TURN_URL=
TRING_TURN_USERNAME=
TRING_TURN_PASSWORD=
