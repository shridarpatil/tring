#######################################################################
#  Tring configuration
#
#  cp .env.example .env   (or just `make up` — it seeds .env for you)
#
#  docker-compose loads this into every service; the Go binaries read
#  TRING_* via koanf. Delete any line to fall back to its built-in
#  default. Values below are tuned for LOCAL DEV on one machine.
#
#  Tring = 2 Go binaries around a PRIVATE FreeSWITCH:
#    api     cmd/api    — REST + admin console + outbound originate via FS ESL
#    gateway  cmd/gateway — pion call plane: /rtc WebSocket, IVR, routing, CDR
#  FreeSWITCH is the outbound/PSTN trunk edge only — web calls (browser→gateway)
#  don't need it at all.
#######################################################################


#======================================================================
# 0. TIMEZONE  (applies to EVERY container)
#
#   One value drives all services: the Go binaries (api/gateway),
#   FreeSWITCH, Postgres and Redis. The Go binaries embed the IANA tz
#   database, so this resolves even on the distroless image. It governs
#   host-local time — notably the IVR Timing node's business hours.
#   Use an IANA name (e.g. Asia/Kolkata, UTC, America/New_York).
#======================================================================

TZ=Asia/Kolkata


#======================================================================
# 1. SECRETS  —  CHANGE THESE IN PRODUCTION
#======================================================================

TRING_JWT_SECRET=tring_dev_jwt_secret_change_me_in_prod
TRING_FS_BASIC_AUTH=fs:fs_dev_secret_change_me_in_prod


#======================================================================
# 2. DATABASE & CACHE
#======================================================================

# [api + gateway -> Postgres] DB connection (dev port 5434, not 5432).
TRING_DSN=postgres://tring:tring_dev@127.0.0.1:5434/tring

# [api + gateway -> Redis] shared flow cache + agent presence + queue depth.
# Both MUST point at the SAME Redis. Empty = all disabled.
# HARD DEPENDENCY for the gateway when TRING_GATEWAY_REQUIRE_AUTH=true.
TRING_REDIS_ADDR=127.0.0.1:6379

# Structured logging. format: text (logfmt, readable locally) | json (for log
# shippers — logchef/Loki). level: debug|info|warn|error.
TRING_LOG_FORMAT=text
TRING_LOG_LEVEL=info


#======================================================================
# 3. FIRST-BOOT BOOTSTRAP  (seeds a tenant + admin on an empty DB)
#   No-op on later boots; changing these does NOT rotate credentials.
#======================================================================

TRING_BOOTSTRAP_TENANT=Default
TRING_ADMIN_EMAIL=admin@tring.local
TRING_ADMIN_PASSWORD=tring_dev_change_me


#======================================================================
# 4. FREESWITCH ESL  (outbound originate + call control)
#
#   The api uses ESL to command FreeSWITCH for outbound PSTN calls
#   (originate, bridge, playback, hold). FreeSWITCH is NOT involved
#   in web/browser calls — those go directly through the call-plane
#   gateway (/rtc).
#======================================================================

# [api -> FreeSWITCH] ESL event socket / control channel.
TRING_ESL_ADDR=127.0.0.1:8021
TRING_ESL_PASSWORD=ClueCon


#======================================================================
# 5. CALL-PLANE GATEWAY  (cmd/gateway — browser WebRTC + IVR + routing)
#
#   The gateway runs the pion media plane: browser WebRTC signaling on
#   /rtc, in-process IVR + agent routing (the brain), and CDR writes.
#   FreeSWITCH is not involved in web calls. Two IPs matter:
#
#   TRING_PUBLIC_IP          browser-facing — fed to pion SetNAT1To1IPs
#                            so the gateway's ICE candidate is reachable
#                            by browsers. Use the public/elastic IP for
#                            internet clients, host LAN IP for same-LAN.
#   TRING_GATEWAY_PUBLIC_URL the browser-reachable base URL the api hands
#                            to visitors (must reach /rtc on the gateway).
#                            dev http://localhost:8087 · prod https://...
#======================================================================

# [browser -> gateway] the gateway URL the api hands a visitor's browser.
TRING_GATEWAY_PUBLIC_URL=http://127.0.0.1:8087

# Public IP of the gateway — rewritten into the gateway's host ICE candidate.
# Required for internet-facing deploys. Empty = no NAT rewrite (LAN/loopback).
TRING_PUBLIC_IP=

# [FreeSWITCH <-> carrier] IP the external (trunk) profile binds AND advertises.
# Empty = primary interface, advertising TRING_PUBLIC_IP. Set it when the
# carrier is on a private circuit on another interface (e.g. Tata SIP-over-AWS:
# the "Customer IP" Tata assigns, on a secondary ENI).
TRING_TRUNK_IP=

# [Meta -> FreeSWITCH] WhatsApp Business Calling over SIP, inbound only (see
# README "WhatsApp calls"). Off unless true: when off, the whatsapp profile is
# not loaded and binds nothing. Needs freeswitch/tls/whatsapp/{agent,cafile}.pem.
TRING_WHATSAPP_ENABLED=false
# IP the whatsapp profile binds. Empty = primary interface.
TRING_WHATSAPP_IP=
# IP advertised to Meta in SIP/SDP. Empty = TRING_PUBLIC_IP, else the bind IP.
TRING_WHATSAPP_PUBLIC_IP=
# TLS port Meta connects to (the port set on the business number). Default 5061.
TRING_WHATSAPP_TLS_PORT=5061

# [proxy -> api] CIDRs of the reverse proxies in front of the api, comma
# separated (e.g. "127.0.0.1/32,10.0.0.0/8"). Only X-Forwarded-For hops
# inside these ranges are trusted when resolving the client IP for the
# access log; the first entry outside them is the client.
# Empty (default) = no proxy, so XFF is ignored entirely and a direct caller
# cannot forge the address we log. Set this ONLY to ranges you actually own —
# a too-wide range lets whoever sits in it spoof client IPs.
TRING_TRUSTED_PROXIES=

# [browser + agents -> gateway] the gateway's own HTTP/WebRTC listen addr.
TRING_GATEWAY_ADDR=:8087

# WebRTC media UDP range (browser ⇄ gateway), ~1 port/call.
# Default caps you at ~100 concurrent calls — widen for real load.
TRING_GATEWAY_UDP_MIN=10000
TRING_GATEWAY_UDP_MAX=10100

# Require a backend-minted call token on /rtc (default true = safe).
# Visitor tokens come from /v1/guest-credentials (your backend, API key).
# Set false to allow the raw anonymous path (browser posts token-less with
# a flow id) — still flow-pinned, but then /rtc is an unauthenticated surface.
# Redis is a HARD dependency when this is true (single-use jti enforcement).
TRING_GATEWAY_REQUIRE_AUTH=true

# Room reconnect grace window (seconds): how long a dropped participant's
# slot is held for a page-refresh before the room tears down. Default 30.
TRING_MEDIA_GRACE_SECONDS=30

# Dev-only: mount an unauthenticated /rtc/dev-token mint so the local test
# client works without a running api. NEVER enable in production.
# TRING_RTC_DEV_TOKENS=false

# ---- Inbound PSTN via FreeSWITCH — the SIP plug (cmd/gateway, internal/fsplug) ----
# OFF by default. Enable only when a SIP trunk (e.g. Tata) is live. When on, the
# gateway runs a SIP UAS; FreeSWITCH bridges inbound carrier calls to it and the
# call becomes a room participant running the same IVR/routing as a web call.
# Needs the gateway DB (flowstore) to map the dialed DID -> flow.
TRING_FSPLUG_ENABLED=false

# [FreeSWITCH -> gateway] the plug's SIP UAS bind. MUST NOT be :5080 — that is
# FreeSWITCH's own external (trunk) profile. This addr must match what FS dials:
# the port = TRING_GATEWAY_SIP_PORT and the advertised IP = TRING_GATEWAY_ADVERT_IP
# (both below). If they disagree, inbound calls never reach the plug.
TRING_FSPLUG_SIP_LISTEN=:5090
TRING_FSPLUG_SIP_ADVERTISE=127.0.0.1

# RTP media range for the FS<->gateway leg (Opus). Separate from the browser
# range (TRING_GATEWAY_UDP_* above). gateway is network_mode: host — OPEN this
# UDP range on the host firewall or the FS<->gateway audio won't flow.
TRING_FSPLUG_RTP_MIN=12000
TRING_FSPLUG_RTP_MAX=12100

# FreeSWITCH side of the same coupling (read by the freeswitch container's
# vars.xml). FS's `tring-gw` gateway proxies inbound carrier calls to
# ${TRING_GATEWAY_ADVERT_IP}:${TRING_GATEWAY_SIP_PORT}. Keep these EQUAL to
# TRING_FSPLUG_SIP_ADVERTISE and the port in TRING_FSPLUG_SIP_LISTEN above.
TRING_GATEWAY_ADVERT_IP=127.0.0.1
TRING_GATEWAY_SIP_PORT=5090


#======================================================================
# 6. CALL RECORDING STORAGE  (optional S3 / S3-compatible)
#
#   Recording itself is a per-tenant toggle in the console (Settings →
#   Record calls). Recordings are always stereo (agent left / customer
#   right). Format + sample rate are configurable:
#     TRING_RECORD_FORMAT      ogg = Ogg Vorbis (default, ~25x smaller
#                              than WAV); mp3 = mod_shout (plays in
#                              Safari/iOS); wav = uncompressed.
#     TRING_RECORD_SAMPLE_RATE Hz; 8000 (default) is telephony narrowband,
#                              16000 = wideband, 0 = session-native (48k).
#
#   By default recordings stay on a local host-mounted spool (RECORDINGS_DIR;
#   ./recordings is bind-mounted into the gateway/api in docker-compose).
#   Set S3 details to upload finished recordings to S3; local copy is
#   deleted after upload. Empty bucket = local only.
#   Works with AWS S3, MinIO, Cloudflare R2 (leave endpoint empty for
#   AWS; set it to your host for MinIO/R2).
#
#   Auth: set ACCESS_KEY + SECRET_KEY for static credentials. Leave BOTH
#   empty on AWS to use the instance's IAM role.
#======================================================================

# Where recordings land on disk (shared mount between api + gateway; the
# gateway writes them, the api serves them).
TRING_RECORDINGS_DIR=/var/lib/tring/recordings

# Recording format/quality. Stereo is always on.
TRING_RECORD_FORMAT=ogg
TRING_RECORD_SAMPLE_RATE=8000

TRING_S3_BUCKET=
TRING_S3_REGION=
TRING_S3_ENDPOINT=
# Leave ACCESS_KEY/SECRET_KEY empty on AWS to use the attached IAM role.
TRING_S3_ACCESS_KEY=
TRING_S3_SECRET_KEY=
TRING_S3_PREFIX=recordings
TRING_S3_USE_SSL=true


#======================================================================
# 6b. IVR AUDIO LIBRARY + TEXT-TO-SPEECH
#
#   TRING_AUDIO_DIR is where the api writes uploaded prompt audio (+
#   synthesized TTS) and where the gateway reads them for IVR playback on
#   the pion media plane. A shared mount between the api + gateway.
#
#   IVR nodes with prompt text but no uploaded audio are synthesized to
#   speech on flow SAVE (by the api) using local Piper + ffmpeg → cached
#   Opus-Ogg, then played like any audio file on both planes. Piper + a
#   default English voice are baked into the image; no config needed for
#   the default voice. TTS no-ops gracefully if the binary/model are
#   absent. Override to use a different / additional voice model:
#     TRING_TTS_PIPER_MODEL  path to a Piper .onnx voice (its .onnx.json
#                            must sit beside it).
#     TRING_TTS_VOICE        speaker id for a multi-speaker model ("" = 0)
#======================================================================

TRING_AUDIO_DIR=/var/lib/tring/sounds
# TRING_TTS_PIPER_BIN=/opt/piper/piper
# TRING_TTS_PIPER_MODEL=/usr/local/share/piper/voice.onnx
# TRING_TTS_VOICE=


#======================================================================
# 7. WebRTC ICE  (STUN / TURN)
#
#   STUN is intentionally OFF — the gateway is the public endpoint, so
#   it learns the browser's address itself (works through symmetric NAT).
#   TURN is only the fallback for UDP-blocking networks (corporate /
#   guest Wi-Fi); prefer TURNS on 443. Set all three together, or none.
#
#   Production / mobile: use EPHEMERAL coturn REST-API credentials via
#   TRING_TURN_SECRET (shared secret; api mints short-lived per-call
#   creds — the secret never reaches clients). Static TURN_USERNAME /
#   TURN_PASSWORD are an alternative for closed dev setups.
#======================================================================

TRING_STUN_URL=
TRING_TURN_URL=
# Static TURN creds — fine for dev; DON'T ship in mobile binaries.
TRING_TURN_USERNAME=
TRING_TURN_PASSWORD=
# Preferred for production: ephemeral creds. Set `use-auth-secret` +
# `static-auth-secret=<this>` in coturn. When set, static creds above are
# ignored. Lifetime = tenant's max call duration.
TRING_TURN_SECRET=
# Force TURN relay for all connections (useful if direct UDP is blocked).
# TRING_TURN_RELAY_ONLY=false


#======================================================================
# 8. IMAGE TAG
#   `develop` tracks latest main; pin a release (e.g. v0.1.0) for prod.
#======================================================================

TRING_TAG=develop
