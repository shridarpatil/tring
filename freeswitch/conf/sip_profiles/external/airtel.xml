<include>
  <gateway name="airtel">
    <param name="username" value="$${airtel_sip_username}"/>
    <param name="password" value="$${airtel_sip_password}"/>
    <param name="realm" value="$${airtel_sip_realm}"/>
    <param name="register" value="$${airtel_register}"/>
    <param name="expire-seconds" value="600"/>
    <param name="retry-seconds" value="30"/>
    <param name="caller-id-in-from" value="true"/>
  </gateway>
</include>
