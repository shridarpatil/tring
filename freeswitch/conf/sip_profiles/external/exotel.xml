<include>
  <gateway name="exotel">
    <param name="username" value="$${exotel_sip_username}"/>
    <param name="password" value="$${exotel_sip_password}"/>
    <param name="realm" value="$${exotel_sip_realm}"/>
    <param name="register" value="$${exotel_register}"/>
    <param name="expire-seconds" value="600"/>
    <param name="retry-seconds" value="30"/>
    <param name="caller-id-in-from" value="true"/>
  </gateway>
</include>
