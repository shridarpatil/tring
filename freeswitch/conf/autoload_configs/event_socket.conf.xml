<configuration name="event_socket.conf" description="Socket Client">
  <!--
    Tring's ESL listener. Replaces the stock file, which listens on every
    interface (::) with the well-known password "ClueCon". The api and the
    gateway are co-located with FreeSWITCH (network_mode: host) and dial
    127.0.0.1:8021 (TRING_ESL_ADDR), so ESL never needs to leave loopback.
    The password is TRING_ESL_PASSWORD, set via vars.xml.
  -->
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="$${tring_esl_password}"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>
