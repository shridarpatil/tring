<include>
  <!-- Tata private-circuit (IP-auth) gateway. Go-live only.
       Copy over the dev register-based gateway when the Tata line is live:

         cp deploy/tata/tata.xml freeswitch/conf/sip_profiles/external/tata.xml
         docker compose up -d --force-recreate freeswitch

       Auth is IP-based — Tata's SBC trusts our SIP LAN IP, we send to the
       SBC via `proxy`. No username/password, no REGISTER. tata_sbc_ip is
       fed from TATA_SBC_IP (.env → compose → vars.xml). -->
  <gateway name="tata">
    <param name="register" value="false"/>
    <param name="proxy" value="$${tata_sbc_ip}"/>
    <param name="realm" value="$${tata_sbc_ip}"/>
    <param name="caller-id-in-from" value="true"/>
  </gateway>
</include>
