# Compiled UI dist embedded by the Go binary at build time. The
# .gitkeep in this dir is intentionally tracked so go:embed always has
# a matching file even on backend-only builds.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Compiled browser widget bundles (voice.js/agent.js/tring.js), copied
# here by `make sdk` and embedded by the Go binary. Same .gitkeep trick.
/internal/widget/dist/*
!/internal/widget/dist/.gitkeep

# Runtime-rendered dynamic gateway XMLs. The api service writes these
# from the trunks table; they're per-deployment, never committed.
/freeswitch/conf/sip_profiles/external/dynamic/t_*.xml

# stray go build output
/gateway

# Python demo caches
__pycache__/
*.pyc
